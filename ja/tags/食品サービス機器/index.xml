        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e3%83%ac%e3%82%b9%e3%83%88%e3%83%a9%e3%83%b3%e5%90%91%e3%81%91%e5%95%86%e6%a5%ad%e7%94%a8%e9%85%8d%e7%ae%a1%e4%bf%a1%e9%a0%bc%e6%80%a7%e3%81%a8%e6%80%a7%e8%83%bd&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
