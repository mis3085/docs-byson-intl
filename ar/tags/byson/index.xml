        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%d8%b1%d8%a4%d9%89-%d8%ad%d9%88%d9%84-%d9%85%d8%b4%d8%a7%d8%b1%d9%83%d8%a9-byson-%d9%81%d9%8a-%d8%a7%d9%84%d8%ad%d8%af%d8%ab-%d8%a7%d9%84%d9%82%d8%a7%d8%af%d9%85&#34; aria-label=&#34;رابط&#34;&gt;#&lt;/a&gt;
